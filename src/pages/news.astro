---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const items = await Promise.all(
  news.map(async (item) => ({ item, Content: (await render(item)).Content })),
);
---

<Base title="News">
  <div class="container">
    <h2><span>News</span></h2>
    <p class="code">SELECT digit FROM code WHERE position = 4; -- 4</p>
    <ul>
      {
        items.map(({ item, Content }) => (
          <li>
            <article>
              <h3>{item.data.title}</h3>
              <time datetime={item.data.date.toISOString()}>
                {item.data.date.toDateString()}
              </time>
              <div class="md">
                <Content />
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  /* Hidden digit: invisible until the text is selected */
  .code {
    color: transparent;
    margin-bottom: var(--sp-s);
  }

  .code::selection {
    background-color: var(--color-primary);
    color: var(--color-text);
  }

  ul > li:not(:last-child) {
    border-bottom: solid grey 1px;
    padding-bottom: var(--sp-l);
    margin-bottom: var(--sp-xl);
  }

  h3 {
    margin-bottom: var(--sp-2xs);
  }

  time {
    display: block;
    margin-bottom: var(--sp-l);
  }
</style>
