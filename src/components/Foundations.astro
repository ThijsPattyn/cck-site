---
import { getCollection } from "astro:content";
import FoundationsCard from "./FoundationsCard.astro";

const foundations = await getCollection("foundations");
---

<section class="container" id="foundations">
  <header>
    <h2><span>Our foundations</span></h2>
    <p>
      These foundations create an environment that encourages innovation,
      creativity, and personal growth.
    </p>
  </header>
  <ul>
    {
      foundations.map((foundation) => (
        <li>
          <FoundationsCard foundation={foundation} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  // Hidden digit: open every foundation to reveal it in the console
  const foundations = document.querySelectorAll("#foundations details");
  let revealed = false;

  foundations.forEach((foundation) => {
    foundation.addEventListener("toggle", () => {
      const allOpen = [...foundations].every((f) => f.hasAttribute("open"));
      if (allOpen && !revealed) {
        revealed = true;
        console.log("Well explored! The first digit of the code is 1");
      }
    });
  });
</script>

<style>
  h2 {
    white-space: nowrap;
  }

  ul {
    counter-reset: counter;
  }
</style>
